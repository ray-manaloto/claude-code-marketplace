# mise-toolkit vendored llms.txt seed
#
# This is a placeholder. After installing the plugin, run:
#
#   /mise-refresh-knowledge
#
# That command will:
#   1. mkdir -p ~/.cache/mise-toolkit/
#   2. curl https://mise.jdx.dev/llms.txt > ~/.cache/mise-toolkit/llms.txt
#
# Skills @-import ~/.cache/mise-toolkit/llms.txt for live, distilled mise best
# practices that stay fresh with every refresh — no plugin update required.
#
# If the cache file doesn't exist when a skill loads, the skill will fall back
# to mise.jdx.dev/llms.txt context links and recommend running the refresh
# command. The plugin still works offline without the cache; the cache just
# makes responses cite the most current mise documentation.
