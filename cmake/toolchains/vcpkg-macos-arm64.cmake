# Shared chainloader for the qualified, uninstrumented compiler lanes.
if(CMAKE_VERSION VERSION_LESS "4.4" OR
   NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin" OR
   NOT CMAKE_HOST_SYSTEM_PROCESSOR STREQUAL "arm64")
  message(FATAL_ERROR "Use CMake 4.4+ on native macOS ARM64.")
endif()
cmake_policy(GET CMP0210 _marketplace_link_policy)
if(_marketplace_link_policy STREQUAL "OLD" OR
   (DEFINED CMAKE_POLICY_DEFAULT_CMP0210 AND NOT CMAKE_POLICY_DEFAULT_CMP0210 STREQUAL "NEW"))
  message(FATAL_ERROR "CMP0210 must be NEW for qualified C++ runtime linking.")
endif()
cmake_policy(SET CMP0210 NEW)
set(CMAKE_POLICY_DEFAULT_CMP0210 NEW)
set(_marketplace_lane "$ENV{MARKETPLACE_CPP_LANE}")
if(_marketplace_lane STREQUAL "p2996")
  set(_marketplace_prefix "/Users/rmanaloto/.local/state/marketplace-tool-foundation/p2996-configure-20261011T051205Z/prefix")
  set(_marketplace_prefix_variable MARKETPLACE_P2996_PREFIX)
  set(_marketplace_other_prefix MARKETPLACE_GCC16_PREFIX)
  set(_marketplace_c clang)
  set(_marketplace_cxx clang++)
elseif(_marketplace_lane STREQUAL "gcc16")
  set(_marketplace_prefix "/opt/homebrew/Cellar/gcc/16.2.0")
  set(_marketplace_prefix_variable MARKETPLACE_GCC16_PREFIX)
  set(_marketplace_other_prefix MARKETPLACE_P2996_PREFIX)
  set(_marketplace_c gcc-16)
  set(_marketplace_cxx g++-16)
else()
  message(FATAL_ERROR "Select exactly one qualified marketplace compiler lane.")
endif()
if(NOT "$ENV{${_marketplace_prefix_variable}}" STREQUAL _marketplace_prefix OR
   NOT "$ENV{${_marketplace_other_prefix}}" STREQUAL "" OR
   NOT VCPKG_TARGET_TRIPLET MATCHES "^arm64-osx-${_marketplace_lane}-(static|dynamic)$")
  message(FATAL_ERROR "Compiler prefix and target triplet must match the selected lane.")
endif()
if((NOT "$ENV{CC}" STREQUAL "" AND NOT "$ENV{CC}" STREQUAL "${_marketplace_prefix}/bin/${_marketplace_c}") OR
   (NOT "$ENV{CXX}" STREQUAL "" AND NOT "$ENV{CXX}" STREQUAL "${_marketplace_prefix}/bin/${_marketplace_cxx}"))
  message(FATAL_ERROR "CC and CXX must match the selected compiler prefix.")
endif()
foreach(_suffix "" _DEBUG _RELEASE)
  if((DEFINED VCPKG_C_FLAGS${_suffix} AND NOT DEFINED VCPKG_CXX_FLAGS${_suffix}) OR
     (DEFINED VCPKG_CXX_FLAGS${_suffix} AND NOT DEFINED VCPKG_C_FLAGS${_suffix}))
    message(FATAL_ERROR "Set both VCPKG C and CXX flag families together.")
  endif()
endforeach()
set(CMAKE_OSX_SYSROOT "/Library/Developer/CommandLineTools/SDKs/MacOSX27.0.sdk" CACHE PATH "Qualified SDK")
set(CMAKE_OSX_DEPLOYMENT_TARGET "27.0" CACHE STRING "Qualified deployment target")
set(CMAKE_OSX_ARCHITECTURES arm64 CACHE STRING "Qualified architecture")
if(NOT CMAKE_OSX_SYSROOT STREQUAL "/Library/Developer/CommandLineTools/SDKs/MacOSX27.0.sdk" OR
   NOT CMAKE_OSX_DEPLOYMENT_TARGET STREQUAL "27.0" OR NOT CMAKE_OSX_ARCHITECTURES STREQUAL "arm64" OR
   (DEFINED CMAKE_SYSTEM_NAME AND NOT CMAKE_SYSTEM_NAME STREQUAL "Darwin") OR
   (DEFINED CMAKE_SYSTEM_PROCESSOR AND NOT CMAKE_SYSTEM_PROCESSOR STREQUAL "arm64") OR
   (DEFINED VCPKG_TARGET_ARCHITECTURE AND NOT VCPKG_TARGET_ARCHITECTURE STREQUAL "arm64"))
  message(FATAL_ERROR "SDK, deployment and architecture must match the qualified host.")
endif()
if(CMAKE_C_COMPILER_FORCED OR CMAKE_CXX_COMPILER_FORCED OR
   CMAKE_TRY_COMPILE_NO_PLATFORM_VARIABLES OR VCPKG_DISABLE_COMPILER_TRACKING OR
   (DEFINED CMAKE_TRY_COMPILE_TARGET_TYPE AND NOT CMAKE_TRY_COMPILE_TARGET_TYPE STREQUAL "EXECUTABLE"))
  message(FATAL_ERROR "Compiler tracking and executable compiler checks must remain enabled.")
endif()
set(CMAKE_TRY_COMPILE_TARGET_TYPE EXECUTABLE)
set(MARKETPLACE_VCPKG_OSX_TOOLCHAIN "/Users/rmanaloto/.local/state/marketplace-tool-foundation/vcpkg-source-e4563094/source/scripts/toolchains/osx.cmake")
file(SHA256 "${MARKETPLACE_VCPKG_OSX_TOOLCHAIN}" _marketplace_osx_sha)
if(NOT _marketplace_osx_sha STREQUAL "6da8c7aca6421bea02b0d9740d7e31effb964fbbed635328895c072175595519")
  message(FATAL_ERROR "The pinned vcpkg macOS toolchain changed.")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/${_marketplace_lane}-macos-arm64.cmake")
if(_marketplace_lane STREQUAL "gcc16")
  include("${MARKETPLACE_VCPKG_OSX_TOOLCHAIN}")
endif()
foreach(_language C CXX)
  string(STRIP "${CMAKE_${_language}_FLAGS_INIT}" CMAKE_${_language}_FLAGS_INIT)
  if(DEFINED CMAKE_${_language}_FLAGS)
    string(STRIP "${CMAKE_${_language}_FLAGS}" _marketplace_existing_flags)
    if(NOT _marketplace_existing_flags STREQUAL CMAKE_${_language}_FLAGS_INIT)
      message(FATAL_ERROR "Conflicting ${_language} flags; use a fresh build directory.")
    endif()
  endif()
endforeach()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES VCPKG_TARGET_TRIPLET)
list(REMOVE_DUPLICATES CMAKE_TRY_COMPILE_PLATFORM_VARIABLES)
