# Consume the qualified task-05 prefix through the existing global mise profile.
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin" OR
   NOT CMAKE_HOST_SYSTEM_PROCESSOR STREQUAL "arm64")
  message(FATAL_ERROR "The GCC16 lane requires a native macOS ARM64 host.")
endif()
if(NOT "$ENV{MARKETPLACE_CPP_LANE}" STREQUAL "gcc16")
  message(FATAL_ERROR "Select the qualified global mise gcc16 environment.")
endif()
set(_gcc_prefix "$ENV{MARKETPLACE_GCC16_PREFIX}")
cmake_path(NORMAL_PATH _gcc_prefix OUTPUT_VARIABLE _gcc_normal)
if(NOT IS_ABSOLUTE "${_gcc_prefix}" OR NOT _gcc_prefix STREQUAL _gcc_normal OR
   NOT EXISTS "${_gcc_prefix}/bin/gcc-16" OR NOT EXISTS "${_gcc_prefix}/bin/g++-16")
  message(FATAL_ERROR "MARKETPLACE_GCC16_PREFIX must be the qualified normalized prefix.")
endif()
foreach(_variable CFLAGS CXXFLAGS CPPFLAGS LDFLAGS CPATH C_INCLUDE_PATH
    CPLUS_INCLUDE_PATH LIBRARY_PATH COMPILER_PATH SDKROOT)
  if(NOT "$ENV{${_variable}}" STREQUAL "")
    message(FATAL_ERROR "Unexpected ${_variable}; use the isolated gcc16 environment.")
  endif()
endforeach()
foreach(_language C CXX)
  if(_language STREQUAL "C")
    set(_compiler "${_gcc_prefix}/bin/gcc-16")
  else()
    set(_compiler "${_gcc_prefix}/bin/g++-16")
  endif()
  if(DEFINED CMAKE_${_language}_COMPILER AND NOT CMAKE_${_language}_COMPILER STREQUAL _compiler)
    message(FATAL_ERROR "Existing ${_language} compiler differs; use a fresh build directory.")
  endif()
  set(CMAKE_${_language}_COMPILER "${_compiler}")
endforeach()
if(NOT IS_ABSOLUTE "${CMAKE_OSX_SYSROOT}" OR NOT EXISTS "${CMAKE_OSX_SYSROOT}/SDKSettings.json")
  message(FATAL_ERROR "Pass CMAKE_OSX_SYSROOT from the qualified SDK receipt.")
endif()
if(NOT CMAKE_OSX_DEPLOYMENT_TARGET MATCHES "^[0-9]+[.][0-9]+$")
  message(FATAL_ERROR "Pass an explicit qualified CMAKE_OSX_DEPLOYMENT_TARGET.")
endif()
set(CMAKE_OSX_ARCHITECTURES "arm64" CACHE STRING "Qualified GCC architecture")
if(NOT CMAKE_OSX_ARCHITECTURES STREQUAL "arm64")
  message(FATAL_ERROR "Only the qualified arm64 architecture is admitted.")
endif()
