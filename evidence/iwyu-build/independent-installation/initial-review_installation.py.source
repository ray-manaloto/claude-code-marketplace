            proposal=rec(E/'proposal.json'),admission=rec(E/'admission.json'),pre_run_review=rec(E/'pre-run-review.json'),
            evidence_manifest=rec(E/'operation-manifest.json'),invocation=rec(E/'invocation/invocation.json'),wrapper_returncode=0,
            commands=[{'case':r['case'],'returncode':r['returncode'],'elapsed_seconds':r['elapsed_seconds']} for r in q['commands']],
            original_log_hashes_verified=80,preflight_command_exits=[0]*5,capacity=q['capacity'],input_hashes=len(proposal['inputs']),tool_hashes=len(proposal['tools']),
            source_files=854,source_git_metadata_unchanged=True,source_observations_matched_baselines=24,default_before_after_matched_registration=True,
            named_profile_matched_proposal=True,cache_values=expected,compile_units=15,link_commands=1,ninja_cdb_recorded_executed_exact=True,
            installed_inventory_entries=27,installed_files=20,native_install_manifest_entries=17,added_license_files=3,installed_binary=rec(binary),macho=image,
            version=version,dyld_images=len(paths),dyld_non_system_images=private,warning_disposition=rec(E/'warning-disposition.json'),build_warnings=11,configure_policy_warnings=1,
            original_Claude_files=19,findings=[],not_run=['compiler or IWYU invocation','profile or environment probes','CMake configure, build or install','network','services or containers','old guard batteries','analysis, resource query, relocation, advice/fixer or reflection rebuild','final lightweight baseline; parent owns it'])
    except BaseException as error:
        report.update(state='FAIL',error=repr(error))
        raise
    finally:
        report['completed_at']=datetime.now(UTC).isoformat();save('artifact-audit.json',report)
    print(json.dumps({'state':report['state'],'original_copy_pairs':104,'private_artifacts':41,'native_commands_observed':40,'compile_units':15,'installed_entries':27,'preserved':True}))


def lease_probe():
    assert load(D/'artifact-audit.json')['state']=='PASS'
    path=Path('/Users/rmanaloto/.local/state/dotfiles/heavy-gate.lock')
    module=Path('/Users/rmanaloto/dev/github/ray-manaloto/dotfiles/python/src/dotfiles_setup/host_lock.py')
    assert sha(module)=='b20e5d969e7534b9a93a61c1ca1669483300aa8949f682be9ee90cda34d72d20'
    assert path.is_file() and not path.is_symlink()
    before=rec(path)|{'mode':oct(stat.S_IMODE(path.stat().st_mode)),'inode':path.stat().st_ino,'mtime_ns':path.stat().st_mtime_ns}
    nodes=[n for n in ast.parse(module.read_text()).body if isinstance(n,ast.FunctionDef) and n.name in ('_try_lock','_probe_free')]
    assert len(nodes)==2
    scope={'Path':Path,'fcntl':fcntl}
    exec(compile(ast.Module(body=nodes,type_ignores=[]),str(module),'exec'),scope)
    report={'started_at':datetime.now(UTC).isoformat(),'module':rec(module),'before':before,'canonical_path':str(path),'probe_invocations':1}
    try:
        free=scope['_probe_free'](path)
        after=rec(path)|{'mode':oct(stat.S_IMODE(path.stat().st_mode)),'inode':path.stat().st_ino,'mtime_ns':path.stat().st_mtime_ns}
        assert before==after and free
        report.update(state='PASS',canonical_lease_free=True,acquired_nonblocking_and_immediately_released=True,owner_record_unchanged=True,after=after)
    except BaseException as error:
        report.update(state='FAIL',error=repr(error));raise
    finally:
        report['completed_at']=datetime.now(UTC).isoformat();save('lease-check.json',report)
    print(json.dumps({'state':'PASS','canonical_lease_free':True,'probe_invocations':1,'owner_record_unchanged':True}))

if __name__=='__main__':{'audit':audit,'lease':lease_probe}[sys.argv[1]]()
