def sha(path):
    with Path(path).open('rb') as stream: return hashlib.file_digest(stream,'sha256').hexdigest()

def load(path): return json.loads(Path(path).read_text())
def save(name,data): (D/name).write_text(json.dumps(data,indent=2)+'\n')
def rec(path):
    p=Path(path)
    return {'path':str(p),'sha256':sha(p),'bytes':p.stat().st_size}

def check_record(row,path=None):
    p=Path(path or row['path'])
    if not p.is_absolute(): p=ROOT/p
    assert sha(p)==row['sha256'],str(p)
    if 'bytes' in row: assert p.stat().st_size==row['bytes'],str(p)

def identity():
    gitdir=Path((ROOT/'.git').read_text().strip().removeprefix('gitdir: '))
    assert (gitdir/'HEAD').read_text()=='ref: refs/heads/codex/marketplace-native-onboarding\n'
    common=(gitdir/(gitdir/'commondir').read_text().strip()).resolve()
    assert common==Path('/Users/rmanaloto/dev/github/ray-manaloto/claude-code-marketplace/.git')
    assert (common/'refs/heads/codex/marketplace-native-onboarding').read_text().strip()==HEAD
    return {'checkout':str(ROOT),'branch':'codex/marketplace-native-onboarding','head':HEAD,'common_git_directory':str(common)}

def protected():
    old=Path('/private/var/folders/z4/0p475gq56vvczc3y4qlt60f80000gn/T/marketplace-iwyu-preparation-review-ojqvvubg/review_preparation.py')
    assert sha(old)=='aaf0ec60e5ae4b3cfc2ed2669a5d13798ad2a008a92fbf6fc6c86c7e2f49c97e'
    node=next(n for n in ast.parse(old.read_text()).body if isinstance(n,ast.FunctionDef) and n.name=='protected')
    scope=globals().copy()
    exec(compile(ast.Module(body=[node],type_ignores=[]),str(old),'exec'),scope)
    return scope['protected']()

def source_current(source,acquired):
    before=load(ROOT/'evidence/iwyu-source/independent-review/source-before.json')
    files={r['path']:r for r in acquired['verified_files']}
    assert len(files)==854
    assert {str(p.relative_to(source)) for p in source.rglob('*') if '.git' not in p.relative_to(source).parts and (p.is_file() or p.is_symlink())}==set(files)
    for name,row in files.items():
        p=source/name
        assert p.is_file() and not p.is_symlink()
        check_record(row,p)
        assert oct(stat.S_IMODE(p.stat().st_mode))==before[name]['mode']
    assert (source/'.git/HEAD').read_text().strip()==acquired['pin']
    return {str(p.relative_to(source/'.git')):{'sha256':sha(p),'mode':oct(stat.S_IMODE(p.stat().st_mode))} for p in (source/'.git').rglob('*') if p.is_file()}

def macho(path):
    data=Path(path).read_bytes()
    magic,cpu,subtype,kind,ncmds,size,flags,reserved=struct.unpack_from('<8I',data)
    assert magic==0xfeedfacf and cpu==0x0100000c and kind==2
    out={'architecture':'arm64','cpu_subtype':subtype,'filetype':'MH_EXECUTE','dylibs':[],'rpaths':[]}
    offset=32
    for _ in range(ncmds):
        cmd,cmdsize=struct.unpack_from('<II',data,offset)
        assert cmdsize>=8 and offset+cmdsize<=32+size
        if cmd in (0xc,0x80000018,0x8000001f,0x8000001c):
            start=struct.unpack_from('<I',data,offset+8)[0]
            value=data[offset+start:offset+cmdsize].split(b'\0',1)[0].decode()
            out['rpaths' if cmd==0x8000001c else 'dylibs'].append(value)
        elif cmd==0x32:
            platform,minimum,sdk,ntools=struct.unpack_from('<4I',data,offset+8)
            out['platform']=platform
            out['minimum_macos']=[minimum>>16,(minimum>>8)&255,minimum&255]
            out['sdk']=[sdk>>16,(sdk>>8)&255,sdk&255]
        offset+=cmdsize
    assert offset==32+size
    return out

