cmake_minimum_required(VERSION 4.4)
cmake_host_system_information(RESULT CMAKE_HOST_SYSTEM_PROCESSOR QUERY OS_PLATFORM)
set(VCPKG_TARGET_TRIPLET arm64-osx-gcc16-static)
set(VCPKG_TARGET_ARCHITECTURE arm64)
set(VCPKG_C_FLAGS "-DMARKETPLACE_C=1")
set(VCPKG_CXX_FLAGS "-DMARKETPLACE_CXX=1")
set(VCPKG_C_FLAGS_DEBUG "-DMARKETPLACE_C_DEBUG=1")
set(VCPKG_CXX_FLAGS_DEBUG "-DMARKETPLACE_CXX_DEBUG=1")
set(VCPKG_C_FLAGS_RELEASE "-DMARKETPLACE_C_RELEASE=1")
set(VCPKG_CXX_FLAGS_RELEASE "-DMARKETPLACE_CXX_RELEASE=1")
set(VCPKG_LINKER_FLAGS "-Wl,-no_warn_duplicate_libraries")
set(VCPKG_LINKER_FLAGS_DEBUG "-Wl,-no_warn_duplicate_libraries")
set(VCPKG_LINKER_FLAGS_RELEASE "-Wl,-no_warn_duplicate_libraries")
include("/Users/rmanaloto/.codex/worktrees/2a14/claude-code-marketplace/cmake/toolchains/vcpkg-macos-arm64.cmake")
foreach(lang C CXX)
  set(before_${lang} "${CMAKE_${lang}_FLAGS_INIT}")
  set(CMAKE_${lang}_FLAGS "${CMAKE_${lang}_FLAGS_INIT}")
endforeach()
include("/Users/rmanaloto/.codex/worktrees/2a14/claude-code-marketplace/cmake/toolchains/vcpkg-macos-arm64.cmake")
foreach(lang C CXX)
  if(NOT CMAKE_${lang}_FLAGS_INIT STREQUAL before_${lang})
    message(FATAL_ERROR "Reentry changed flags")
  endif()
  string(REGEX MATCHALL "-fPIC" pics "${CMAKE_${lang}_FLAGS_INIT}")
  list(LENGTH pics pic_count)
  if(NOT pic_count EQUAL 1)
    message(FATAL_ERROR "Expected one PIC token")
  endif()
endforeach()
foreach(name CMAKE_C_COMPILER CMAKE_CXX_COMPILER CMAKE_C_FLAGS_INIT CMAKE_CXX_FLAGS_INIT CMAKE_CXX_LINK_FLAGS CMAKE_OSX_SYSROOT CMAKE_OSX_DEPLOYMENT_TARGET CMAKE_OSX_ARCHITECTURES CMAKE_C_FLAGS_DEBUG_INIT CMAKE_CXX_FLAGS_DEBUG_INIT CMAKE_C_FLAGS_RELEASE_INIT CMAKE_CXX_FLAGS_RELEASE_INIT CMAKE_EXE_LINKER_FLAGS_INIT CMAKE_EXE_LINKER_FLAGS_DEBUG_INIT CMAKE_EXE_LINKER_FLAGS_RELEASE_INIT CMAKE_TRY_COMPILE_PLATFORM_VARIABLES)
  message(STATUS "${name}=${${name}}")
endforeach()
cmake_policy(GET CMP0210 result_policy)
message(STATUS "CMP0210=${result_policy}")
