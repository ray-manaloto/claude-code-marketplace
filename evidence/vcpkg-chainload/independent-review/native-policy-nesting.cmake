if(NOT DEFINED REVIEW_MINIMUM OR NOT DEFINED REVIEW_EXPECT_ENTRY_POLICY)
  message(FATAL_ERROR "Missing nested-policy review parameters")
endif()
cmake_minimum_required(VERSION ${REVIEW_MINIMUM})
cmake_host_system_information(RESULT CMAKE_HOST_SYSTEM_PROCESSOR QUERY OS_PLATFORM)
set(VCPKG_TARGET_TRIPLET "arm64-osx-$ENV{MARKETPLACE_CPP_LANE}-static")
set(VCPKG_TARGET_ARCHITECTURE arm64)
set(VCPKG_MANIFEST_DIR "")
set(VCPKG_MANIFEST_MODE OFF CACHE BOOL "Review only")
set(VCPKG_MANIFEST_INSTALL OFF CACHE BOOL "Review only")
set(VCPKG_TOOLCHAIN TRUE)
set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE "/Users/rmanaloto/.codex/worktrees/2a14/claude-code-marketplace/cmake/toolchains/vcpkg-macos-arm64.cmake")
set(review_native_vcpkg "/Users/rmanaloto/.local/state/marketplace-tool-foundation/vcpkg-source-e4563094/source/scripts/buildsystems/vcpkg.cmake")
cmake_policy(GET CMP0210 review_outer_before)
if(NOT review_outer_before STREQUAL "NEW")
  message(FATAL_ERROR "Outer policy must be selected before inclusion")
endif()
include("${review_native_vcpkg}")
if(NOT "${_marketplace_link_policy}" STREQUAL "${REVIEW_EXPECT_ENTRY_POLICY}")
  message(FATAL_ERROR "Unexpected native nested adapter entry policy")
endif()
set(review_first_entry "${_marketplace_link_policy}")
if(NOT CMAKE_POLICY_DEFAULT_CMP0210 STREQUAL "NEW")
  message(FATAL_ERROR "Adapter failed to retain NEW policy default")
endif()
foreach(lang C CXX)
  set(review_flags_${lang} "${CMAKE_${lang}_FLAGS_INIT}")
  set(CMAKE_${lang}_FLAGS "${CMAKE_${lang}_FLAGS_INIT}")
endforeach()
include("${review_native_vcpkg}")
cmake_policy(GET CMP0210 review_outer_after)
if(NOT review_outer_after STREQUAL "NEW" OR NOT _marketplace_link_policy STREQUAL "NEW")
  message(FATAL_ERROR "Outer or repeated nested policy changed")
endif()
foreach(lang C CXX)
  if(NOT CMAKE_${lang}_FLAGS_INIT STREQUAL review_flags_${lang})
    message(FATAL_ERROR "Native nested reentry changed ${lang} flags")
  endif()
  string(REGEX MATCHALL "-fPIC" review_pics "${CMAKE_${lang}_FLAGS_INIT}")
  list(LENGTH review_pics review_pic_count)
  if(NOT review_pic_count EQUAL 1)
    message(FATAL_ERROR "Native nested reentry lost or duplicated PIC")
  endif()
endforeach()
if(NOT _VCPKG_OSX_TOOLCHAIN OR NOT CMAKE_TRY_COMPILE_TARGET_TYPE STREQUAL "EXECUTABLE")
  message(FATAL_ERROR "Native composition or executable check contract missing")
endif()
message(STATUS "NATIVE_POLICY_NESTING=PASS;lane=$ENV{MARKETPLACE_CPP_LANE};minimum=${REVIEW_MINIMUM};first_entry=${review_first_entry};second_entry=${_marketplace_link_policy};outer=${review_outer_after}")
message(STATUS "CMAKE_C_FLAGS_INIT=${CMAKE_C_FLAGS_INIT}")
message(STATUS "CMAKE_CXX_FLAGS_INIT=${CMAKE_CXX_FLAGS_INIT}")
message(STATUS "CMAKE_CXX_LINK_FLAGS=${CMAKE_CXX_LINK_FLAGS}")
