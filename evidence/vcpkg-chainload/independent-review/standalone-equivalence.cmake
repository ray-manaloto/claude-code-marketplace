cmake_minimum_required(VERSION 4.4)
cmake_host_system_information(RESULT CMAKE_HOST_SYSTEM_PROCESSOR QUERY OS_PLATFORM)
if(NOT DEFINED REVIEW_TOOLCHAIN)
  message(FATAL_ERROR "Missing review toolchain")
endif()
set(review_vars CMAKE_C_COMPILER CMAKE_CXX_COMPILER CMAKE_C_FLAGS_INIT CMAKE_CXX_FLAGS_INIT CMAKE_CXX_LINK_FLAGS CMAKE_CXX_STANDARD_LIBRARIES_INIT CMAKE_OSX_SYSROOT CMAKE_OSX_DEPLOYMENT_TARGET CMAKE_OSX_ARCHITECTURES CMAKE_TRY_COMPILE_TARGET_TYPE)
include("${REVIEW_TOOLCHAIN}")
foreach(name IN LISTS review_vars)
  set(saved_${name} "${${name}}")
endforeach()
set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS_INIT}")
set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS_INIT}")
include("${REVIEW_TOOLCHAIN}")
foreach(name IN LISTS review_vars)
  if(NOT "${${name}}" STREQUAL "${saved_${name}}")
    message(FATAL_ERROR "Standalone reentry changed ${name}")
  endif()
  message(STATUS "${name}=${${name}}")
endforeach()
if(DEFINED MARKETPLACE_VCPKG_OSX_TOOLCHAIN OR _VCPKG_OSX_TOOLCHAIN OR _p2996_vcpkg_initialized)
  message(FATAL_ERROR "Standalone inclusion unexpectedly entered vcpkg composition")
endif()
if(CMAKE_C_FLAGS_INIT MATCHES "-fPIC" OR CMAKE_CXX_FLAGS_INIT MATCHES "-fPIC")
  message(FATAL_ERROR "Standalone inclusion gained vcpkg PIC flags")
endif()
cmake_policy(GET CMP0210 review_policy)
if(NOT review_policy STREQUAL "NEW")
  message(FATAL_ERROR "Standalone policy was changed")
endif()
message(STATUS "STANDALONE_REENTRY=PASS;CMP0210=${review_policy}")
