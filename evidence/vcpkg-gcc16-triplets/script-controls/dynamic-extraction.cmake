cmake_minimum_required(VERSION 3.5)
macro(vcpkg_triplet_file VCPKG_TRIPLET_ID)
set(_caller_file "${CMAKE_CURRENT_LIST_FILE}")
set(_caller_dir "${CMAKE_CURRENT_LIST_DIR}")
set(CMAKE_CURRENT_LIST_FILE "/Users/rmanaloto/.codex/worktrees/2a14/claude-code-marketplace/triplets/arm64-osx-gcc16-dynamic.cmake")
get_filename_component(CMAKE_CURRENT_LIST_DIR "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
set(_marketplace_triplet_lane gcc16)
set(VCPKG_LIBRARY_LINKAGE dynamic)
include("${CMAKE_CURRENT_LIST_DIR}/common/macos-arm64.cmake")
set(CMAKE_CURRENT_LIST_FILE "${_caller_file}")
set(CMAKE_CURRENT_LIST_DIR "${_caller_dir}")
endmacro()
function(extract VCPKG_TRIPLET_ID)
 if(DEFINED CMAKE_HOST_SYSTEM_PROCESSOR)
  message(FATAL_ERROR "Extractor must start without a public processor value")
 endif()
 set(_expected_file "${CMAKE_CURRENT_LIST_FILE}")
 set(_expected_dir "${CMAKE_CURRENT_LIST_DIR}")
 vcpkg_triplet_file(${VCPKG_TRIPLET_ID})
 if(DEFINED CMAKE_HOST_SYSTEM_PROCESSOR OR NOT CMAKE_CURRENT_LIST_FILE STREQUAL _expected_file OR NOT CMAKE_CURRENT_LIST_DIR STREQUAL _expected_dir)
  message(FATAL_ERROR "Extraction changed public processor or caller context")
 endif()

if(NOT VCPKG_TARGET_ARCHITECTURE STREQUAL "arm64" OR
 NOT VCPKG_CRT_LINKAGE STREQUAL "dynamic" OR
 NOT VCPKG_CMAKE_SYSTEM_NAME STREQUAL "Darwin" OR DEFINED VCPKG_BUILD_TYPE OR
 NOT VCPKG_OSX_DEPLOYMENT_TARGET STREQUAL "27.0" OR
 NOT VCPKG_OSX_SYSROOT STREQUAL "/Library/Developer/CommandLineTools/SDKs/MacOSX27.0.sdk" OR
 NOT VCPKG_CMAKE_CONFIGURE_OPTIONS STREQUAL "-DCMAKE_POLICY_DEFAULT_CMP0210=NEW" OR
 NOT VCPKG_ENV_PASSTHROUGH STREQUAL "MARKETPLACE_CPP_LANE;MARKETPLACE_GCC16_PREFIX")
 message(FATAL_ERROR "GCC triplet contract mismatch")
endif()
list(LENGTH VCPKG_HASH_ADDITIONAL_FILES count)
if(NOT count EQUAL 12)
 message(FATAL_ERROR "GCC ABI input count mismatch")
endif()
foreach(input IN LISTS VCPKG_HASH_ADDITIONAL_FILES)
 file(SHA256 "${input}" digest)
 message(STATUS "ABI=${input}|${digest}")
endforeach()
set(before "${VCPKG_HASH_ADDITIONAL_FILES}")
include("/Users/rmanaloto/.codex/worktrees/2a14/claude-code-marketplace/triplets/arm64-osx-gcc16-dynamic.cmake")
if(NOT before STREQUAL VCPKG_HASH_ADDITIONAL_FILES)
 message(FATAL_ERROR "GCC triplet reentry changed ABI inputs")
endif()
if(NOT VCPKG_LIBRARY_LINKAGE STREQUAL "dynamic")
 message(FATAL_ERROR "GCC linkage mismatch")
endif()
message(STATUS "GCC_TRIPLET_PASS:dynamic")
endfunction()
extract(0)
