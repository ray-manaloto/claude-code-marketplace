"""Read-only acceptance rules for the two-compiler native core matrix."""

import ast
from collections import Counter
from pathlib import Path
import re
import shlex

from gcc_install import digest

CONFIGS = {"Debug": ["-g"], "Release": ["-O3", "-DNDEBUG"],
           "RelWithDebInfo": ["-O2", "-g", "-DNDEBUG"], "MinSizeRel": ["-Os", "-DNDEBUG"]}
STRICT = ["-pedantic-errors", "-Wall", "-Wextra", "-Werror"]


def unwrap(arguments):
    if arguments[:2] == [":", "&&"] and arguments[-2:] == ["&&", ":"]:
        return arguments[2:-2]
    return arguments[:]


def numbered_commands(text):
    return [shlex.split(line.split("] ", 1)[1]) for line in text.splitlines()
            if re.match(r"^\[[0-9]+/[0-9]+\] ", line)]


class CoreCommands:
    def __init__(self, root, build, lane, prefix, sdk, cmake, ar, ranlib, shared):
        assert lane in ("p2996", "gcc16")
        self.root, self.build, self.prefix = map(Path, (root, build, prefix))
        assert self.build.is_absolute() and self.build.resolve() == self.build
        self.lane, self.sdk, self.cmake = lane, str(sdk), str(cmake)
        self.ar, self.ranlib, self.shared = str(ar), str(ranlib), shared
        self.cxx = str(self.prefix / "bin" / ("clang++" if lane == "p2996" else "g++-16"))
        self.libraries = [self.prefix / "lib" / n for n in ("libc++.dylib", "libc++abi.dylib", "libunwind.dylib")]
        path = self.root / "dev/toolchains/p2996_cmake.py"
        assert digest(path) == "b2b0a4b2fdff733dfc149b90773940ba64cc7654e83f34f6dac82119a0086ade"
        node = next(n for n in ast.walk(ast.parse(path.read_text())) if isinstance(n, ast.FunctionDef) and n.name == "flags")
        scope = {"prefix": self.prefix, "configuration": {"sdk": {"path": self.sdk}}, "libraries": self.libraries}
        exec(compile(ast.Module(body=[node], type_ignores=[]), str(path), "exec"), scope)
        self.p2996_flags, self.database = scope["flags"], {}

    def flags(self, arguments, linking=False, reflection=False, standard=False):
        args = unwrap(arguments)
        assert args[0] == self.cxx
        if "-install_name" in args:
            i = args.index("-install_name")
            assert linking and self.shared and "-dynamiclib" in args and args.count("-install_name") == 1
            assert args[i + 1] == "@rpath/libresearch_core.dylib"
            args = args[:i] + args[i + 2:]
        assert not any(a.startswith("@") or a == ":" or any(c in a for c in ";&|<>`$") for a in args)
        for key, value in (("-arch", "arm64"), ("-isysroot", self.sdk)):
            assert args.count(key) == 1 and args[args.index(key) + 1] == value
        assert "-mmacosx-version-min=27.0" in args and args.count("-freflection") == int(reflection)
        if standard:
            assert [a for a in args if a.startswith("-std=")] == ["-std=c++26"]
        if self.lane == "p2996":
            self.p2996_flags(args, True, linking=linking, reflection=reflection, standard=standard)
        else:
            assert not any(a.startswith(("-stdlib=", "-nostdinc++", "-nostdlib++", "-resource-dir")) for a in args)
            assert not any("/p2996-" in a or "/opt/homebrew/opt/llvm" in a for a in args)
        return args

    def object(self, config, name):
        target = "research_core" if name == "core" else "research_core_smoke"
        return f"CMakeFiles/{target}.dir/{config}/src/{name}.cpp.o"

    def compile_database(self, rows):
        assert len(rows) == 8
        outputs = []
        for row in rows:
            assert Path(row["directory"]) == self.build
            name = Path(row["file"]).stem
            assert name in ("core", "smoke") and Path(row["file"]) == self.root / "src" / (name + ".cpp")
            args = self.flags(shlex.split(row["command"]), reflection=name == "core", standard=True)
            configs = [a.split("=", 1)[1].strip('"') for a in args if a.startswith("-DCMAKE_INTDIR=")]
            assert len(configs) == 1 and configs[0] in CONFIGS
            config, key = configs[0], (configs[0], name)
            assert key not in self.database
            obj = self.object(config, name)
            assert args.count("-o") == args.count("-c") == 1 and args[-4:] == ["-o", obj, "-c", row["file"]]
            output = (self.build / obj).resolve()
            assert output.is_relative_to(self.build) and output == (self.build / row["output"]).resolve()
            assert all(flag in args for flag in STRICT + CONFIGS[config])
            assert ("-fPIC" in args) == (name == "core")
            assert ("-fno-declone-ctor-dtor" in args) == (self.lane == "gcc16" and config == "MinSizeRel")
            assert ("-Dresearch_core_EXPORTS" in args) == (self.shared and name == "core")
            allowed = {self.cxx, '-DCMAKE_INTDIR="' + config + '"', "-I" + str(self.root / "include"),
                       "-std=c++26", "-arch", "arm64", "-isysroot", self.sdk, "-mmacosx-version-min=27.0",
                       "-o", obj, "-c", row["file"], *STRICT, *CONFIGS[config]}
            if name == "core":
                allowed.update(("-freflection", "-fPIC"))
                if self.shared:
                    allowed.add("-Dresearch_core_EXPORTS")
            if self.lane == "gcc16":
                module = ["-fmodules-ts", "-fmodule-mapper=" + obj + ".modmap", "-MD", "-fdeps-format=p1689r5", "-x", "c++"]
                assert args[-10:-4] == module
                allowed.update(module)
                if config == "MinSizeRel":
                    allowed.add("-fno-declone-ctor-dtor")
            else:
                allowed.update(("--no-default-config", "-fno-blocks", "-resource-dir", str(self.prefix / "lib/clang/21"),
                                "-stdlib=libc++", "-nostdinc++", "-isystem", str(self.prefix / "include/c++/v1")))
            assert set(args) <= allowed and args.count("-I" + str(self.root / "include")) == 1
            self.database[key] = args
            outputs.append(str(output))
        assert len(set(outputs)) == 8 and set(self.database) == {(c, n) for c in CONFIGS for n in ("core", "smoke")}
        return outputs

    def actions(self, commands, config):
        assert config in CONFIGS and len(commands) == (8 if self.lane == "gcc16" else 4)
        found = []
        library = config + "/libresearch_core" + (".dylib" if self.shared else ".a")
        for original in commands:
            args = unwrap(original)
            if args[0] == self.cxx:
                if "-c" in args:
                    name = Path(args[-1]).stem
                    assert name in ("core", "smoke") and args.count("-MT") == 1
                    obj, i = self.object(config, name), args.index("-MT") - 1
                    assert args[i:i + 5] == ["-MD", "-MT", obj, "-MF", obj + ".d"]
                    assert args[:i] + args[i + 5:] == self.database[(config, name)]
                    found.append("compile-" + name)
                elif "-E" in args:
                    assert self.lane == "gcc16"
                    name = Path(args[args.index("-E") + 3]).stem
                    obj, db = self.object(config, name), self.database[(config, name)]
                    expected = db[:db.index("-fmodules-ts")] + ["-E", "-x", "c++", str(self.root / "src" / (name + ".cpp")),
                        "-MT", obj + ".ddi", "-MD", "-MF", obj + ".ddi.d", "-fmodules-ts", "-fdeps-file=" + obj + ".ddi",
                        "-fdeps-target=" + obj, "-fdeps-format=p1689r5", "-o", obj + ".ddi.i"]
                    assert args == expected
                    found.append("scan-" + name)
                else:
                    shared = "-dynamiclib" in args
                    self.flags(args, linking=True)
                    target = library if shared else config + "/research_core_smoke"
                    name = "core" if shared else "smoke"
                    assert not shared or self.shared
                    assert args.count("-o") == 1 and args[args.index("-o") + 1] == target
                    assert [a for a in args if a.endswith(".o")] == [self.object(config, name)]
                    allowed = {self.cxx, *CONFIGS[config], "-arch", "arm64", "-isysroot", self.sdk,
                               "-mmacosx-version-min=27.0", "-Wl,-headerpad_max_install_names", "-o", target, self.object(config, name)}
                    if shared:
                        assert args.count("-install_name") == 1 and args[args.index("-install_name") + 1] == "@rpath/libresearch_core.dylib"
                        allowed.update(("-dynamiclib", "-install_name", "@rpath/libresearch_core.dylib"))
                    else:
                        assert args.count(library) == 1
                        allowed.update(("-Wl,-search_paths_first", library))
                        if self.shared:
                            rpath = "-Wl,-rpath," + str(self.build / config)
                            assert args.count(rpath) == 1
                            allowed.add(rpath)
                    if self.lane == "p2996":
                        allowed.update(("--no-default-config", "-fno-blocks", "-resource-dir", str(self.prefix / "lib/clang/21"),
                                        "-stdlib=libc++", "-nostdinc++", "-isystem", str(self.prefix / "include/c++/v1"),
                                        "-nostdlib++", *map(str, self.libraries), "-Wl,-rpath," + str(self.prefix / "lib")))
                    assert set(args) <= allowed and all(f in args for f in CONFIGS[config])
                    found.append("link-" + name)
            elif args[:3] == [self.cmake, "-E", "cmake_ninja_dyndep"]:
                assert self.lane == "gcc16"
                targets = {"core": "research_core", "smoke": "research_core_smoke"}
                matches = []
                for name, target in targets.items():
                    base = f"CMakeFiles/{target}.dir/{config}/"
                    if args == [self.cmake, "-E", "cmake_ninja_dyndep", "--tdi=" + base + "CXXDependInfo.json",
                                "--lang=CXX", "--modmapfmt=gcc", "--dd=" + base + "CXX.dd", "@" + base + "CXX.dd.rsp"]:
                        matches.append(name)
                assert len(matches) == 1
                found.append("dyndep-" + matches[0])
            else:
                assert not self.shared
                expected = [self.cmake, "-E", "rm", "-f", library, "&&", self.ar, "qc", library,
                            self.object(config, "core"), "&&", self.ranlib, library]
                touch = ["&&", self.cmake, "-E", "touch", library]
                assert original[:2] == [":", "&&"] and original[-2:] == ["&&", ":"]
                assert args == expected + touch or (self.lane == "p2996" and args == expected)
                found.append("archive-core")
        expected = ["compile-core", "compile-smoke", "link-smoke", "link-core" if self.shared else "archive-core"]
        if self.lane == "gcc16":
            expected += ["scan-core", "scan-smoke", "dyndep-core", "dyndep-smoke"]
        assert Counter(found) == Counter(expected)
        return found

    @staticmethod
    def actual_matches(generated, actual):
        assert Counter(map(tuple, generated)) == Counter(map(tuple, actual))
