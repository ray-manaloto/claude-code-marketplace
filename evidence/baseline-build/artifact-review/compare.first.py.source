    FT[Path(row['source']).name]=row['text']
assert json.loads(FT['execution.json'])==first_exec and json.loads(FT['launch.json'])==first_launch
assert 'line 103, in main' in FT['stderr'] and 'writer_census_before' in FT['stderr'] and '30352' in FT['stderr']
assert sha256(FT['stdout'].encode()).hexdigest()==first_exec['stdout_sha256'] and sha256(FT['stderr'].encode()).hexdigest()==first_exec['stderr_sha256']
capacity=J(E/'retry-capacity/capacity.json'); assert H(E/'retry-capacity/capacity.json')==admission['capacity_sha256'] and capacity['state']=='PASS'
assert J(E/'retry-capacity/execution.json')['returncode']==0 and all(row['returncode']==0 for row in capacity['commands'])
assert not capacity['active_build_processes'] and not capacity['held_lease'] and not capacity['native_operation_started']
assert datetime.fromisoformat(first_close['recorded_at'])<datetime.fromisoformat(capacity['recorded_at'])<datetime.fromisoformat(admission['recorded_at'])<datetime.fromisoformat(native['started_at'])
assert capacity['docker_context']==admission['docker_context'] and capacity['containers']==admission['containers']
cmake=contract['managed_tools']['cmake']['path']; ctest=contract['managed_tools']['ctest']['path']; ninja=contract['managed_tools']['ninja']['path']; sdk='/Library/Developer/CommandLineTools/SDKs/MacOSX27.0.sdk'
sandbox=['/usr/bin/sandbox-exec','-f',str(OP/'private.sb')]; launcher=sandbox+[native['argv'][0],'-B','-c','import os,sys;os.chdir(sys.argv[1]);os.execv(sys.argv[2],sys.argv[2:])',str(R)]
expected_cases=['project-head','default-before','capacity-processes','docker-context','docker-census','docker-stats']; binaries=[]; witnesses=[]
expected_tails={lane+'-core-'+core+'-fmt-'+linkage for lane in ('p2996','gcc16') for core in ('static','shared') for linkage in ('static','dynamic')}
assert set(q['cells'])==expected_tails and closure['baseline_cells']==32 and closure['arm64_artifacts']==64
for tail,cell in q['cells'].items():
    lane,_,core,_,linkage=tail.split('-'); preset='configure-'+tail; build=OP/'trees'/preset; triplet='arm64-osx-'+lane+'-'+linkage; installed=Path(contract['fmt_root'])/triplet/'installed'/triplet
    expected_cases.append(preset); assert commands[preset]['argv']==launcher+[cmake,'--preset',preset] and cell['triplet']==triplet and cell['configure_preset']==preset
    cache=dict(re.findall(r'^([^#/:\r\n][^:=\r\n]*):[^=\r\n]+=(.*)$',TX(build/'CMakeCache.txt'),re.MULTILINE)); assert cache==cell['cache']
    compiler=dict(re.findall(r'^set\((CMAKE_CXX_COMPILER(?:_ID|_VERSION)?) "([^"\n]*)"\)$',TX(build/'CMakeFiles/4.4.4/CMakeCXXCompiler.cmake'),re.MULTILINE))
    comp=contract['compilers'][lane]; assert compiler==cell['compiler']=={'CMAKE_CXX_COMPILER':comp['CXX'],'CMAKE_CXX_COMPILER_ID':comp['id'],'CMAKE_CXX_COMPILER_VERSION':comp['version']}
    values={'BUILD_SHARED_LIBS':'ON' if core=='shared' else 'OFF','RESEARCH_CORE_WITH_FMT':'ON','CMAKE_OSX_SYSROOT':sdk,'CMAKE_OSX_ARCHITECTURES':'arm64','CMAKE_OSX_DEPLOYMENT_TARGET':'27.0','CMAKE_MAKE_PROGRAM':ninja,'VCPKG_TARGET_TRIPLET':triplet,'VCPKG_INSTALLED_DIR':str(installed.parent),'fmt_DIR':str(installed/'share/fmt'),'CMAKE_CONFIGURATION_TYPES':';'.join(contract['configurations'])}
    values.update({k:'OFF' for k in ('VCPKG_MANIFEST_MODE','VCPKG_MANIFEST_INSTALL','VCPKG_APPLOCAL_DEPS','CMAKE_FIND_USE_PACKAGE_REGISTRY','CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY')})
    assert all(cache[k]==v for k,v in values.items()),tail
    compile_text=TX(build/'compile_commands.json'); assert sha256(compile_text.encode()).hexdigest()==cell['compile_commands_sha256']; cc=json.loads(compile_text); assert len(cc)==8
    assert set(cell['runs'])==set(contract['configurations'])
    for configuration,run in cell['runs'].items():
        label=tail+'-'+configuration; expected_cases.extend(label+'-'+x for x in ('build','test','arch-binary','arch-library','run'))
        assert commands[label+'-build']['argv']==launcher+[cmake,'--build','--preset','build-'+configuration+'-'+tail,'--verbose']
        assert commands[label+'-test']['argv']==launcher+[ctest,'--preset','test-'+configuration+'-'+tail,'--output-junit',str(build/(configuration+'-tests.xml'))]
        core_meta=dict(line.split('=',1) for line in TX(build/('core-'+configuration+'.txt')).splitlines()); fmt_meta=dict(line.split('=',1) for line in TX(build/('fmt-'+configuration+'.txt')).splitlines())
        assert core_meta=={k:run[k] for k in ('library','kind','binary','configuration','shared')} and fmt_meta==run['fmt']
        suffix='d' if configuration=='Debug' else ''; fmt_path=installed/('debug/lib' if configuration=='Debug' else 'lib')/('libfmt'+suffix+('.12.2.0.dylib' if linkage=='dynamic' else '.a'))
        assert fmt_meta=={'library':str(fmt_path),'kind':'SHARED_LIBRARY' if linkage=='dynamic' else 'STATIC_LIBRARY'}
        assert core_meta=={'library':str(build/configuration/('libresearch_core.dylib' if core=='shared' else 'libresearch_core.a')),'kind':'SHARED_LIBRARY' if core=='shared' else 'STATIC_LIBRARY','binary':str(build/configuration/'research_core_smoke'),'configuration':configuration,'shared':values['BUILD_SHARED_LIBS']}
        log=TX(OP/(label+'-build.stdout')); assert ninja+' -v -j 1 -f build-'+configuration+'.ninja' in log and str(fmt_path) in log
        for source in ('core.cpp','smoke.cpp'):
            selected=[row for row in cc if Path(row['file']).name==source and '/'+configuration+'/' in row['output']]; assert len(selected)==1
            actual=[line for line in log.splitlines() if ' -c '+str(R/'src'/source) in line]; assert len(actual)==1
            for line in (selected[0]['command'],actual[0].split('] ',1)[1]):
                args=shlex.split(line); assert args[0]==comp['CXX'] and '-std=c++26' in args and ('-freflection' in args)==(source=='core.cpp')
                assert args[args.index('-isysroot')+1]==sdk and args[args.index('-arch')+1]=='arm64' and '-mmacosx-version-min=27.0' in args
                assert '-fPIC' in args and '-DFMT_HEADER_ONLY' not in args
                flags={'Debug':['-g'],'Release':['-O3','-DNDEBUG'],'RelWithDebInfo':['-O2','-g','-DNDEBUG'],'MinSizeRel':['-Os','-DNDEBUG']}[configuration]
                assert all(flag in args for flag in flags) and ('-DNDEBUG' in args)==(configuration!='Debug')
                if lane=='p2996': assert '--no-default-config' in args and '-nostdinc++' in args and str(Path(contract['prefixes'][lane])/'include/c++/v1') in args
                if lane=='gcc16': assert ('-fno-declone-ctor-dtor' in args)==(configuration=='MinSizeRel')
        xml=TX(build/(configuration+'-tests.xml')); assert sha256(xml.encode()).hexdigest()==run['ctest_junit_sha256']; suite=ET.fromstring(xml)
        assert suite.attrib['tests']=='1' and all(suite.attrib[k]=='0' for k in ('failures','disabled','skipped')); cases=suite.findall('testcase'); assert len(cases)==1
        case=cases[0]; assert case.attrib['name']=='research_core_smoke' and case.attrib['status']=='run' and case.find('failure') is None and case.find('skipped') is None and case.findtext('system-out')=='reflection value=43, members=1\n'
        assert '100% tests passed out of 1' in TX(OP/(label+'-test.stdout')) and TX(OP/(label+'-test.stderr'))==''
        for kind in ('binary','library'):
            assert commands[label+'-arch-'+kind]['argv']==sandbox+['/usr/bin/lipo','-archs',run[kind]] and TX(OP/(label+'-arch-'+kind+'.stdout')).strip()=='arm64'
            binaries.append({'path':run[kind],'sha256':run['sha256'][kind],'kind':kind})
        assert commands[label+'-run']['argv']==sandbox+[native['argv'][0],'-B','-c',"import os,sys;os.execve(sys.argv[1],sys.argv[1:],dict(os.environ,DYLD_PRINT_LIBRARIES='1'))",run['binary']]
        assert TX(OP/(label+'-run.stdout'))=='reflection value=43, members=1\n'; trace=TX(OP/(label+'-run.stderr'))
        lines=[line for line in trace.splitlines() if line.startswith('dyld[') and '/' in line]; assert lines and all(line.startswith('dyld['+str(commands[label+'-run']['pid'])+']:') for line in lines)
        loaded={str(Path(line[line.index('/'):]).resolve()) for line in lines}; assert loaded==set(run['loaded'])
        for prefix,path,dynamic in [('libfmt',fmt_path,linkage=='dynamic'),('libresearch_core',Path(run['library']),core=='shared')]: assert {p for p in loaded if Path(p).name.startswith(prefix)}==({str(path.resolve())} if dynamic else set())
        runtimes=['lib/libc++.dylib','lib/libc++abi.dylib','lib/libunwind.dylib'] if lane=='p2996' else ['lib/gcc/current/libstdc++.6.dylib']
        assert all(str((Path(contract['prefixes'][lane])/p).resolve()) in loaded for p in runtimes)
        system=sorted(p for p in loaded if p.startswith('/usr/lib/') and ('libc++' in p or 'libunwind' in p)); assert system
        witnesses.append({'cell':label,'dependency_configuration':'Debug' if configuration=='Debug' else 'Release','system_cpp_runtimes':system})
expected_cases.append('default-after'); assert list(commands)==expected_cases and len(witnesses)==32
