out={'result':'PASS','candidate_sha256':H(E/'artifact-candidate.json'),'helper_sha256':q['helper_sha256'],'contract_sha256':prepared['contract_sha256'],'qualification_sha256':a['qualification_sha256'],'operation_directory':str(OP),'first_attempt':{'returncode':1,'commands':0,'cells':0,'failure':'unknown mise process 30352 in writer census before lease','later_process_absence_recorded':True},'retry':{'returncode':0,'elapsed_seconds':native['elapsed_seconds'],'command_outcomes':175,'configure_trees':8,'build_test_runtime_cells':32,'arm64_artifacts':64},'exact_retry_text_source_pairs':579,'text_pair_index_sha256':sha256(json.dumps(text_index,separators=(',',':')).encode()).hexdigest(),'exact_first_launch_source_pairs':4,'original_frozen_snapshots':7,'new_binary_file_reads_and_hashes':64,'new_binary_artifacts':binaries,'cell_witnesses':witnesses,'parent_closure_pid_absences':175,'source_and_install_preservation':'attested by reviewed runner; inventories not repeated','parent_static_returncodes':[0,0],'parent_baseline_original_hashes':19,'parent_scan_raw_returncode':1,'parent_scan_verified_digest_dispositions':5,'parent_scan_transformed_returncode':0,'parent_scan_current_review_bindings_checked':scan_checked,'reviewer_native_execution':False,'watched_text_hashes':watched}
(D/'comparison.json').write_text(json.dumps(out,indent=2)+'\n')
