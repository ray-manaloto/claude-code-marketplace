assert native['helper_sha256']==q['helper_sha256']==admission['helper_sha256']==review['helper_sha256']==a['files']['dev/toolchains/baseline.py']
assert admission['contract_sha256']==review['contract_sha256']==prepared['contract_sha256']
assert admission['review_sha256']==H(E/'pre-run-review.json') and admission['candidate_sha256']==a['prepared_candidate_sha256']
assert native['admission_sha256']==q['admission_sha256']==H(E/'admission.json') and all(native[k]==v for k,v in launch.items())
OP=Path(admission['run_directory']); LP=Path(native['private_launch_directory']); assert H(OP/'qualification.json')==a['qualification_sha256']
assert native['argv']==[native['argv'][0],'-E','-B',str(R/'dev/toolchains/baseline.py'),'--run-dir',str(OP),'--build']
assert native['argv'][0] in contract['tools'] and admission['python_flags']==['-E','-B']
assert 83<native['elapsed_seconds']<84 and abs((datetime.fromisoformat(native['finished_at'])-datetime.fromisoformat(native['started_at'])).total_seconds()-native['elapsed_seconds'])<1
texts=J(E/'operation/text-receipts.json')['files']; assert len(texts)==579 and len({row['source'] for row in texts})==579
assert H(E/'operation/text-receipts.json')==a['text_receipts_sha256']==closure['text_receipts_sha256']=='a53845e6aa898082dec1475576fa8eb99f2e4fec4b1ada0c748e1351c53ec816'
T={}; text_index=[]
for row in texts:
    p=Path(row['source']); b=row['text'].encode(); assert p.is_relative_to(OP) or p.is_relative_to(LP)
    assert len(b)==row['bytes'] and sha256(b).hexdigest()==row['sha256'] and p.read_bytes()==b,p
    T[str(p)]=row['text']; text_index.append((str(p),row['sha256'],row['bytes']))
def TX(p): return T[str(p)]
