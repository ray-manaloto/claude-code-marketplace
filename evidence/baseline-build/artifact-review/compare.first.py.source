first=J(E/'attempt-1/qualification.json'); first_exec=J(E/'attempt-1/native-execution.json'); first_adm=J(E/'attempt-1/admission.json'); first_close=J(E/'attempt-1/closure.json'); first_launch=J(E/'attempt-1/native-launch.json')
