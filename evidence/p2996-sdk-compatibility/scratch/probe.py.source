"""Scratch-only syntax controls for the captured SDK comparator failure."""
import ast
from datetime import datetime, timezone
import hashlib
import importlib.util
import io
import json
import os
from pathlib import Path
import shlex
import signal
import subprocess
import sys
import time

ROOT = Path('/Users/rmanaloto/.codex/worktrees/2a14/claude-code-marketplace')
sys.path.insert(0, str(ROOT / 'dev/toolchains'))
from gcc_install import digest, preserved, read
from p2996_configure import LOCK_MODULE, LOCK_SHA

directory = Path(__file__).resolve().parent
proposal = json.loads((directory / 'proposal.json').read_text())
source = Path(proposal['source'])
failed = ROOT / 'evidence/p2996-build/failed-cold-build'
operation = json.loads((failed / 'qualification.json').read_text())
report = {'state': 'running', 'commands': [], 'proposal': proposal,
          'harness_sha256': digest(Path(__file__))}
normal_argv = read('install-preimages.json')['normal_environment']['argv']
env = json.loads((Path(normal_argv[-1]).parent / 'context.json').read_text())['environment'] | {
    'MISE_OFFLINE': '1', 'MISE_AUTO_INSTALL': '0', 'MISE_EXEC_AUTO_INSTALL': '0'}

def save():
    temporary = directory / 'qualification.json.tmp'
    temporary.write_text(json.dumps(report, indent=2) + '\n')
    temporary.replace(directory / 'qualification.json')

# Reuse the exact reviewed subprocess cleanup, timeout and durable-log routine.
helper = ROOT / 'dev/toolchains/p2996_build.py'
assert digest(helper) == 'ef179e70c3bf2daa804c077a810cff8f1912bb41c4e89c60f55d488abf8f9ecd'
node = next(n for n in ast.walk(ast.parse(helper.read_text()))
            if isinstance(n, ast.FunctionDef) and n.name == 'run')
exec(compile(ast.Module(body=[node], type_ignores=[]), str(helper), 'exec'))

def interrupted(signum, frame):
    raise KeyboardInterrupt('received signal ' + str(signum))

for signum in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
    signal.signal(signum, interrupted)

try:
    assert not (directory / 'qualification.json').exists()
    assert digest(directory / 'rdf-comparator.patch') == proposal['patch_sha256']
    for row in proposal['files']:
        assert digest(source / row['path']) == row['before_sha256']
        assert digest(directory / 'tree' / row['path']) == row['after_sha256']
    configuration = operation['proposal']['configuration']
    for row in operation['proposal']['inputs'].values():
        assert digest(Path(row.get('resolved_path', row.get('path')))) == row['sha256']
    assert digest(Path(configuration['sdk']['path']) / 'SDKSettings.json') == configuration['sdk']['settings_sha256']
    argv = next(row['argv'] for row in operation['commands'] if row['case'] == 'llvm-build')
    base = argv[:argv.index(configuration['cmake']['resolved_path'])]
    (directory / 'cwd').mkdir()
    base[base.index('-C') + 1] = str(directory / 'cwd')
    lines = (failed / 'llvm-build.stdout').read_text().splitlines()
    original = shlex.split(lines[next(i for i, line in enumerate(lines) if line.startswith('FAILED:')) + 1])
    flags = []
    skip = False
    for value in original:
        if skip:
            skip = False
        elif value in ('-o', '-MF', '-MT'):
            skip = True
        elif value not in ('-MD', '-c'):
            flags.append(value)
    assert flags[-1] == str(source / 'llvm/lib/CodeGen/RDFGraph.cpp')
    flags = flags[:-1] + ['-fsyntax-only']
    assert digest(LOCK_MODULE) == LOCK_SHA
    spec = importlib.util.spec_from_file_location('marketplace_probe_lock', LOCK_MODULE)
    lease = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(lease)
    assert not os.environ.get(lease.holder_env_name(lease.HEAVY_GATE)) and not os.environ.get(lease.LOCK_FD_ENV)
    with lease.held(lease.HEAVY_GATE, 'marketplace-sdk-comparator-probe', wait_s=0, out=io.StringIO()) as fd:
        assert fd is not None
        census = run('capacity-processes', ['/bin/ps', '-axo', 'pid=,pcpu=,comm='])
        active = [line for line in census.splitlines() if Path(line.split(maxsplit=2)[-1]).name in
                  {'cmake', 'ninja', 'make', 'clang', 'clang++', 'clang-21', 'cc1plus', 'gcc-16', 'g++-16'}]
        assert not active
        report['capacity'] = {'load': os.getloadavg(), 'cpus': os.cpu_count(), 'active_builds': active,
                              'total_cpu_percent': sum(float(line.split()[1]) for line in census.splitlines())}
        assert report['capacity']['load'][0] <= report['capacity']['cpus']
        assert report['capacity']['total_cpu_percent'] <= 50 * report['capacity']['cpus']
        preserved(operation['protected_before'])
        try:
            run('original-negative', base + flags + [source / 'llvm/lib/CodeGen/RDFGraph.cpp'], timeout=45, descriptor=fd)
            raise RuntimeError('original unexpectedly compiled')
        except AssertionError:
            assert report['commands'][-1]['returncode'] == 1
            diagnostic = (directory / 'original-negative.stderr').read_text()
            assert 'is_empty<_Comparator>::value' in diagnostic and 'less<void>' in diagnostic
        for label, path in [('graph', source / 'llvm/lib/CodeGen/RDFGraph.cpp'),
                            ('liveness', directory / 'tree/llvm/lib/CodeGen/RDFLiveness.cpp'),
                            ('copy', directory / 'tree/llvm/lib/Target/Hexagon/RDFCopy.cpp')]:
            run('patched-' + label, base + [flags[0], '-I' + str(directory / 'tree/llvm/include'),
                                          *flags[1:], path], timeout=45, descriptor=fd)
    report['lease_released'] = True
    report['state'] = 'PASS: original failure reproduced; three patched translation units passed syntax checks'
except BaseException as error:
    report.update(state='FAIL', error=repr(error))
    raise
finally:
    preserved(operation['protected_before'])
    for row in proposal['files']:
        assert digest(source / row['path']) == row['before_sha256']
    report['source_and_protected_state_unchanged'] = True
    save()
    print(json.dumps({'state': report['state'], 'receipt': str(directory / 'qualification.json')}), flush=True)
