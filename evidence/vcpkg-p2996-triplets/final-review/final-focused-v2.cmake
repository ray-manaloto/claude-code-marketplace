cmake_minimum_required(VERSION 3.5)
if(REVIEW_PROCESSOR_MODE STREQUAL "undefined")
  unset(CMAKE_HOST_SYSTEM_PROCESSOR)
elseif(REVIEW_PROCESSOR_MODE STREQUAL "empty")
  set(CMAKE_HOST_SYSTEM_PROCESSOR "")
elseif(REVIEW_PROCESSOR_MODE STREQUAL "conflict")
  set(CMAKE_HOST_SYSTEM_PROCESSOR "x86_64")
else()
  message(FATAL_ERROR "Missing review processor case")
endif()
if(REVIEW_BUILD_TYPE_MODE STREQUAL "empty")
  set(VCPKG_BUILD_TYPE "")
elseif(REVIEW_BUILD_TYPE_MODE STREQUAL "release")
  set(VCPKG_BUILD_TYPE release)
elseif(NOT REVIEW_BUILD_TYPE_MODE STREQUAL "undefined")
  message(FATAL_ERROR "Missing review build-type case")
endif()
macro(vcpkg_triplet_file VCPKG_TRIPLET_ID)
  set(_vcpkg_triplet_file_BACKUP_CURRENT_LIST_FILE "${CMAKE_CURRENT_LIST_FILE}")
  if(VCPKG_TRIPLET_ID EQUAL 0)
    set(CMAKE_CURRENT_LIST_FILE "/Users/rmanaloto/.codex/worktrees/2a14/claude-code-marketplace/triplets/arm64-osx-p2996-static.cmake")
    get_filename_component(CMAKE_CURRENT_LIST_DIR "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
set(_marketplace_triplet_lane p2996)
set(VCPKG_LIBRARY_LINKAGE static)
include("${CMAKE_CURRENT_LIST_DIR}/common/macos-arm64.cmake")
  elseif(VCPKG_TRIPLET_ID EQUAL 1)
    set(CMAKE_CURRENT_LIST_FILE "/Users/rmanaloto/.codex/worktrees/2a14/claude-code-marketplace/triplets/arm64-osx-p2996-dynamic.cmake")
    get_filename_component(CMAKE_CURRENT_LIST_DIR "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
set(_marketplace_triplet_lane p2996)
set(VCPKG_LIBRARY_LINKAGE dynamic)
include("${CMAKE_CURRENT_LIST_DIR}/common/macos-arm64.cmake")
  else()
    message(FATAL_ERROR "Missing review triplet case")
  endif()
  set(CMAKE_CURRENT_LIST_FILE "${_vcpkg_triplet_file_BACKUP_CURRENT_LIST_FILE}")
  get_filename_component(CMAKE_CURRENT_LIST_DIR "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
endmacro()
function(review_extract VCPKG_TRIPLET_ID)
  set(review_caller_file "${CMAKE_CURRENT_LIST_FILE}")
  set(review_caller_dir "${CMAKE_CURRENT_LIST_DIR}")
  vcpkg_triplet_file(${REVIEW_TRIPLET_ID})
  if(NOT "${CMAKE_CURRENT_LIST_FILE}" STREQUAL "${review_caller_file}" OR NOT "${CMAKE_CURRENT_LIST_DIR}" STREQUAL "${review_caller_dir}")
    message(FATAL_ERROR "Emitted macro failed to restore caller list context")
  endif()
  if(NOT "${_marketplace_host_processor}" STREQUAL "arm64")
    message(FATAL_ERROR "Private host processor did not resolve arm64")
  endif()
  if(REVIEW_PROCESSOR_MODE STREQUAL "undefined" AND DEFINED CMAKE_HOST_SYSTEM_PROCESSOR)
    message(FATAL_ERROR "Private host query changed undefined public processor")
  elseif(REVIEW_PROCESSOR_MODE STREQUAL "empty" AND (NOT DEFINED CMAKE_HOST_SYSTEM_PROCESSOR OR NOT "${CMAKE_HOST_SYSTEM_PROCESSOR}" STREQUAL ""))
    message(FATAL_ERROR "Private host query changed explicitly empty public processor")
  endif()
  if(DEFINED VCPKG_BUILD_TYPE)
    message(FATAL_ERROR "Accepted a defined build type")
  endif()
  if(NOT "${_marketplace_project}" STREQUAL "/Users/rmanaloto/.codex/worktrees/2a14/claude-code-marketplace" OR NOT "${VCPKG_CHAINLOAD_TOOLCHAIN_FILE}" STREQUAL "/Users/rmanaloto/.codex/worktrees/2a14/claude-code-marketplace/cmake/toolchains/vcpkg-macos-arm64.cmake")
    message(FATAL_ERROR "Nested include resolved incorrect project or chainloader")
  endif()
  list(LENGTH VCPKG_HASH_ADDITIONAL_FILES review_abi_count)
  if(NOT review_abi_count EQUAL 13 OR NOT "/Users/rmanaloto/.codex/worktrees/2a14/claude-code-marketplace/triplets/common/macos-arm64.cmake" IN_LIST VCPKG_HASH_ADDITIONAL_FILES)
    message(FATAL_ERROR "Nested common ABI input is absent")
  endif()
  set(review_first_abi "${VCPKG_HASH_ADDITIONAL_FILES}")
  set(review_first_linkage "${VCPKG_LIBRARY_LINKAGE}")
  vcpkg_triplet_file(${REVIEW_TRIPLET_ID})
  if(NOT "${VCPKG_HASH_ADDITIONAL_FILES}" STREQUAL "${review_first_abi}" OR NOT "${VCPKG_LIBRARY_LINKAGE}" STREQUAL "${review_first_linkage}")
    message(FATAL_ERROR "Emitted macro reentry changed its result")
  endif()
  if(NOT "${CMAKE_CURRENT_LIST_FILE}" STREQUAL "${review_caller_file}" OR NOT "${CMAKE_CURRENT_LIST_DIR}" STREQUAL "${review_caller_dir}")
    message(FATAL_ERROR "Macro reentry failed caller restoration")
  endif()
  message(STATUS "FOCUSED_PASS:host=${REVIEW_PROCESSOR_MODE};private=${_marketplace_host_processor};linkage=${VCPKG_LIBRARY_LINKAGE};abi_count=${review_abi_count};reentry=stable;caller=restored")
endfunction()
review_extract(${REVIEW_TRIPLET_ID})
