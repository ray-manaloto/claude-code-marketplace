"""Compare scratch-only repairs for the captured SDK math-macro failure."""

import argparse
import ast
from datetime import datetime, timezone
import difflib
import importlib.util
import io
import json
import os
from pathlib import Path
import shlex
import signal
import subprocess
import sys
import time

from gcc_install import ROOT, digest, preserved, read
from mise_link_probe import snapshot
from p2996_configure import LOCK_MODULE, LOCK_SHA
from vcpkg_register import install_entries

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--run-dir", type=Path, required=True)
args = parser.parse_args()
directory = args.run_dir
if not directory.is_absolute() or directory != directory.resolve() or directory.is_relative_to(ROOT):
    parser.error("use a new normalized absolute private directory outside this worktree")
os.umask(0o077)
directory.mkdir(exist_ok=False)
load = lambda p: json.loads(p.read_text())
failed = ROOT / "evidence/p2996-resume/failed-incremental-build"
operation = load(failed / "qualification.json")
closure_path = ROOT / "evidence/p2996-resume/failure-closure-review.json"
closure = load(closure_path)
configuration = operation["proposal"]["configuration"]
source = Path(configuration["source"])
build = Path(operation["proposal"]["workspace"]) / "build"
header = source / "clang/lib/Headers/float.h"
clamp = source / "libcxx/include/__random/clamp_to_integral.h"
protected_before = load(ROOT / "evidence/p2996-build/independent-preparation/pre-state.json")
report = {"state": "running", "commands": [], "helper_sha256": digest(Path(__file__))}
normal_argv = read("install-preimages.json")["normal_environment"]["argv"]
env = load(Path(normal_argv[-1]).parent / "context.json")["environment"] | {
    "MISE_OFFLINE": "1", "MISE_AUTO_INSTALL": "0", "MISE_EXEC_AUTO_INSTALL": "0",
    "GIT_CONFIG_GLOBAL": "/dev/null", "GIT_CONFIG_SYSTEM": "/dev/null", "GIT_TERMINAL_PROMPT": "0"}


def save():
    temporary = directory / "qualification.json.tmp"
    temporary.write_text(json.dumps(report, indent=2) + "\n")
    temporary.replace(directory / "qualification.json")


# Execute the unchanged, reviewed timeout/cleanup routine from the failed run.
helper = failed / "helper.py.source"
assert digest(helper) == "eb10682c0014e1ba5d8409ef641f46b1037f18b88a5abc68cb6d2c44d6fbfb9f"
node = next(n for n in ast.walk(ast.parse(helper.read_text()))
            if isinstance(n, ast.FunctionDef) and n.name == "run")
exec(compile(ast.Module(body=[node], type_ignores=[]), str(helper), "exec"))


def protected():
    preserved(protected_before["protected"])
    assert all(snapshot(Path(p)) == value for p, value in protected_before["directories"].items())
    assert install_entries(Path.home() / ".local/share/mise/installs") == protected_before["install_entries"]


def interrupted(signum, frame):
    raise KeyboardInterrupt("received signal " + str(signum))


for signum in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
    signal.signal(signum, interrupted)
try:
    assert closure["result"].startswith("PASS") and not closure["findings"]
    assert closure["operation_sha256"] == digest(failed / "qualification.json")
    assert digest(header) == "c3e534e33cffd9ba9f02eaa548dce411d26570cac04019df21b7295c6bd2bdaf"
    assert digest(clamp) == "02e70e725be490bb68fb225055928c31e5d6583bf3bc41cc6e84fd8a9d089d21"
    for path, sha in closure["incremental_state"].items():
        assert digest(Path(path)) == sha
    compiler = build / "bin/clang++"
    retained = {str(p): digest(p) for p in (header, clamp, compiler, build / "lib/clang/21/include/float.h",
                                          build / "include/c++/v1/__random/clamp_to_integral.h")}
    before = header.read_text()
    marker = "#ifndef __CLANG_FLOAT_H\n"
    assert before.count(marker) == 1
    prefix, body = before.split(marker)
    branch = ("#ifdef __need_infinity_nan\n"
              "/* Handle partial requests even after a normal inclusion of float.h. */\n"
              "#  undef INFINITY\n#  undef NAN\n#  define INFINITY (__builtin_inff())\n"
              "#  define NAN (__builtin_nanf(\"\"))\n#  undef __need_infinity_nan\n#else\n\n")
    after = prefix + branch + marker + body + "\n#endif /* __need_infinity_nan */\n"
    overlay = directory / "compiler-overlay"
    overlay.mkdir()
    (overlay / "float.h").write_text(after)
    candidate_path = ROOT / "evidence/p2996-math-compatibility/source-candidate.json"
    assert digest(overlay / "float.h") == load(candidate_path)["candidate"]["sha256"]
    patch = directory / "sdk-math.patch"
    patch.write_text("".join(difflib.unified_diff(before.splitlines(True), after.splitlines(True),
                     fromfile="a/clang/lib/Headers/float.h", tofile="b/clang/lib/Headers/float.h")))
    clamp_overlay = directory / "clamp-overlay/__random"
    clamp_overlay.mkdir(parents=True)
    (clamp_overlay / "clamp_to_integral.h").write_text(clamp.read_text().replace(
        "static_cast<_RealT>(__max_val), INFINITY", "static_cast<_RealT>(__max_val), numeric_limits<float>::infinity()"))
    proposal = {"source": str(source), "base_commit": configuration["pin"], "patch_sha256": digest(patch),
                "files": [{"path": "clang/lib/Headers/float.h", "before_sha256": digest(header),
                           "after_sha256": digest(overlay / "float.h")}],
                "prior_source_diff_sha256": operation["proposal"]["sdk_adaptation"]["diff_sha256"],
                "failure_closure_sha256": digest(closure_path), "state": "PREPARED_SCRATCH_ONLY"}
    report.update(proposal=proposal, retained=retained)
    (directory / "proposal.json").write_text(json.dumps(proposal, indent=2) + "\n")
    macros = directory / "macros.cpp"
    macros.write_text("#include <cfloat>\n#include <cmath>\n#ifndef INFINITY\n#error MISSING_INFINITY\n#endif\n"
                      "#ifndef NAN\n#error MISSING_NAN\n#endif\n"
                      "static_assert(__is_same(decltype(INFINITY), float));\n"
                      "static_assert(__is_same(decltype(NAN), float));\n"
                      "static_assert(__builtin_isinf(INFINITY) && INFINITY > 0);\n"
                      "static_assert(__builtin_isnan(NAN));\n")
    requests = directory / "requests.cpp"
    requests.write_text("#if REQUEST_FIRST\n#define __need_infinity_nan\n#include <float.h>\n"
                        "#ifdef __CLANG_FLOAT_H\n#error PREMATURE_FULL_GUARD\n#endif\n#endif\n"
                        "#include <float.h>\n#ifndef FLT_MANT_DIG\n#error MISSING_FULL_HEADER\n#endif\n"
                        "#define __need_infinity_nan\n#include <float.h>\n"
                        "#define __need_infinity_nan\n#include <float.h>\n"
                        "#ifdef __need_infinity_nan\n#error UNCONSUMED_REQUEST\n#endif\n"
                        "static_assert(__builtin_isinf(INFINITY));\nstatic_assert(__builtin_isnan(NAN));\n")
    test = source / "libcxx/test/libcxx/numerics/clamp_to_integral.pass.cpp"
    report["upstream_test"] = {"path": str(test), "sha256": digest(test)}
    argv = next(row["argv"] for row in operation["commands"] if row["case"] == "llvm-build")
    base = argv[:argv.index(configuration["cmake"]["resolved_path"])]
    (directory / "cwd").mkdir()
    base[base.index("-C") + 1] = str(directory / "cwd")
    lines = (failed / "llvm-build.stdout").read_text().splitlines()
    original = shlex.split(lines[next(i for i, line in enumerate(lines) if line.startswith("FAILED:")) + 1])
    flags, skip = [], False
    for value in original:
        if skip:
            skip = False
        elif value in ("-o", "-MF", "-MT"):
            skip = True
        elif value not in ("-MD", "-c"):
            flags.append(value)
    assert flags[0] == str(compiler) and flags[-1] == str(source / "libcxx/src/random_shuffle.cpp")
    syntax = [*flags[:-1], "-fsyntax-only", flags[-1]]
    public = [str(compiler), "-nostdinc++", "-I" + str(build / "include/c++/v1"),
              "-isysroot", configuration["sdk"]["path"], "-mmacosx-version-min=27.0", "-arch", "arm64"]
    git = ["/usr/bin/git", "-c", "core.fsmonitor=false", "-C", source]
    assert run("source-head", git + ["rev-parse", "HEAD"]).strip() == configuration["pin"]
    assert run("source-tree", git + ["rev-parse", "HEAD^{tree}"]).strip() == configuration["tree"]
    assert run("source-diff-before", git + ["diff", "--no-ext-diff", "--binary"])
    assert digest(directory / "source-diff-before.stdout") == proposal["prior_source_diff_sha256"]
    assert digest(LOCK_MODULE) == LOCK_SHA
    spec = importlib.util.spec_from_file_location("marketplace_math_probe_lock", LOCK_MODULE)
    lease = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(lease)
    assert lease.lock_path(lease.HEAVY_GATE) == Path.home() / ".local/state/dotfiles/heavy-gate.lock"
    assert not os.environ.get(lease.holder_env_name(lease.HEAVY_GATE)) and not os.environ.get(lease.LOCK_FD_ENV)
    with lease.held(lease.HEAVY_GATE, "marketplace-sdk-math-probe", wait_s=0, out=io.StringIO()) as fd:
        assert fd is not None
        census = run("capacity-processes", ["/bin/ps", "-axo", "pid=,pcpu=,comm="])
        active = [line for line in census.splitlines() if Path(line.split(maxsplit=2)[-1]).name in
                  {"cmake", "ninja", "make", "clang", "clang++", "clang-21", "cc1plus", "gcc-16", "g++-16"}]
        assert not active and os.getloadavg()[0] <= os.cpu_count()
        assert sum(float(line.split()[1]) for line in census.splitlines()) <= 50 * os.cpu_count()
        protected()

        def expect_failure(label, command, diagnostic):
            try:
                run(label, base + command, timeout=45, descriptor=fd)
            except AssertionError:
                assert report["commands"][-1]["returncode"] == 1
                assert diagnostic in (directory / (label + ".stderr")).read_text()
            else:
                raise RuntimeError(label + " unexpectedly passed")

        expect_failure("original-negative", syntax, "undeclared identifier 'INFINITY'")
        run("clamp-candidate-syntax", base + [syntax[0], "-I" + str(clamp_overlay.parent), *syntax[1:]], timeout=45, descriptor=fd)
        expect_failure("clamp-candidate-macros", [public[0], "-I" + str(clamp_overlay.parent), *public[1:], "-std=c++23", "-fsyntax-only", macros], "MISSING_INFINITY")
        run("compiler-candidate-syntax", base + [syntax[0], "-I" + str(overlay), *syntax[1:]], timeout=45, descriptor=fd)
        for standard in ("c++17", "c++23", "c++26"):
            run("macros-" + standard, base + [public[0], "-I" + str(overlay), *public[1:], "-std=" + standard, "-Werror", "-fsyntax-only", macros], timeout=45, descriptor=fd)
        for first in (0, 1):
            run("requests-" + str(first), base + [public[0], "-I" + str(overlay), *public[1:], "-std=c++23", "-Werror", "-DREQUEST_FIRST=" + str(first), "-fsyntax-only", requests], timeout=45, descriptor=fd)
        run("upstream-test-build", base + [public[0], "-I" + str(overlay), *public[1:], "-std=c++23", "-fno-exceptions", "-fno-rtti", "-nostdlib++", test, "-o", directory / "clamp-test"], timeout=45, descriptor=fd)
        run("upstream-test-run", [directory / "clamp-test"], timeout=15, descriptor=fd)
        run("source-diff-after", git + ["diff", "--no-ext-diff", "--binary"])
        assert digest(directory / "source-diff-after.stdout") == proposal["prior_source_diff_sha256"]
    report["lease_released"] = True
    report["state"] = "PASS: compiler-header candidate restores SDK macros and passes upstream boundaries"
except BaseException as error:
    report.update(state="FAIL", error=repr(error))
    raise
finally:
    try:
        protected()
        assert all(digest(Path(path)) == sha for path, sha in report.get("retained", {}).items())
        assert all(digest(Path(path)) == sha for path, sha in closure["incremental_state"].items())
        report["source_build_and_protected_state_unchanged"] = True
    except BaseException as error:
        report.update(state="FAIL", preservation_error=repr(error))
        raise
    finally:
        save()
        print(json.dumps({"state": report["state"], "receipt": str(directory / "qualification.json")}), flush=True)
