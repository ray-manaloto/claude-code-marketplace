{
  "version": 2,
  "runtime_expected_sdk_version": "0.16.1",
  "runtime_preflight_timeout_seconds": 10,
  "scope": ["LLVM exact version pins", "mise installation and upgrade --bump", "Renovate native mise manager", "IWYU compiler and resource compatibility", "reproducible CI examples"],
  "max_new_searches_per_refresh": 5,
  "max_changed_searches_per_refresh": 5,
  "max_active_searches": 40,
  "max_refinement_rounds_per_refresh": 1,
  "max_primary_examples_per_refresh": 5,
  "catalog": "searches.json",
  "results": "results",
  "catalog_history": "catalog-history",
  "change_log": "search-changes.jsonl",
  "report_directory": "reports",
  "example_index": "examples.md",
  "require_source_url_for_refinement": true,
  "require_primary_source_before_promoting_example": true,
  "preserve_exact_tool_versions": true,
  "partial_results_are_exhaustive": false,
  "max_code_pages_per_run": 10,
  "max_issue_pr_pages_per_run": 25,
  "minimum_seconds_between_runs": 65,
  "command_timeout_seconds": 180,
  "workflow_research_interval_hours": 24,
  "repeat_error_trigger": 2,
  "capped_query_trigger": 2,
  "stale_query_trigger": 6,
  "max_workflow_rule_changes_per_refresh": 2,
  "max_identical_quota_retries_per_day": 1,
  "require_measurable_candidate_expectation": true,
  "require_inspected_relevance_anchor": true,
  "runner": "refresh.py",
  "learning_state": "learning-state.json",
  "learning_events": "learning-events.jsonl",
  "lessons": "lessons.json",
  "workflow_research_state": "workflow-research-state.json"
}
