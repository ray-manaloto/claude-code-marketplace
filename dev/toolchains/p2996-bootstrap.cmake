# Initial cache for the pinned LLVM fork; execute only in the admitted bootstrap operation.
if(NOT "$ENV{MARKETPLACE_CPP_LANE}" STREQUAL "tools-only")
  message(FATAL_ERROR "Select the isolated cpp-build environment for bootstrap.")
endif()
foreach(_name CC CXX CFLAGS CXXFLAGS CPPFLAGS LDFLAGS)
  if(NOT "$ENV{${_name}}" STREQUAL "")
    message(FATAL_ERROR "Inherited ${_name} must be cleared before bootstrap.")
  endif()
endforeach()
foreach(_name CC CXX SDK NINJA PYTHON PREFIX)
  set(_value "$ENV{MARKETPLACE_BOOTSTRAP_${_name}}")
  if(NOT IS_ABSOLUTE "${_value}" OR _value STREQUAL "/")
    message(FATAL_ERROR "Provide an attested absolute MARKETPLACE_BOOTSTRAP_${_name}.")
  endif()
  if(NOT _name STREQUAL "PREFIX" AND NOT EXISTS "${_value}")
    message(FATAL_ERROR "Bootstrap input does not exist: ${_name}")
  endif()
endforeach()
set(CMAKE_C_COMPILER "$ENV{MARKETPLACE_BOOTSTRAP_CC}" CACHE FILEPATH "Attested bootstrap C compiler" FORCE)
set(CMAKE_CXX_COMPILER "$ENV{MARKETPLACE_BOOTSTRAP_CXX}" CACHE FILEPATH "Attested bootstrap C++ compiler" FORCE)
set(CMAKE_OSX_SYSROOT "$ENV{MARKETPLACE_BOOTSTRAP_SDK}" CACHE PATH "Attested SDK" FORCE)
set(CMAKE_MAKE_PROGRAM "$ENV{MARKETPLACE_BOOTSTRAP_NINJA}" CACHE FILEPATH "Managed Ninja" FORCE)
set(Python3_EXECUTABLE "$ENV{MARKETPLACE_BOOTSTRAP_PYTHON}" CACHE FILEPATH "Existing Python" FORCE)
set(CMAKE_INSTALL_PREFIX "$ENV{MARKETPLACE_BOOTSTRAP_PREFIX}" CACHE PATH "New private prefix" FORCE)
set(CMAKE_BUILD_TYPE Release CACHE STRING "Toolchain build configuration" FORCE)
set(CMAKE_OSX_ARCHITECTURES arm64 CACHE STRING "Native architecture" FORCE)
set(CMAKE_OSX_DEPLOYMENT_TARGET 27.0 CACHE STRING "Qualified host platform" FORCE)
set(CMAKE_INSTALL_RPATH "@loader_path/../lib" CACHE STRING "Relocatable tool libraries" FORCE)
set(LLVM_ENABLE_PROJECTS "clang;clang-tools-extra" CACHE STRING "Required development tools" FORCE)
set(LLVM_ENABLE_RUNTIMES "libunwind;libcxxabi;libcxx;compiler-rt" CACHE STRING "Matching fork runtimes" FORCE)
set(LLVM_TARGETS_TO_BUILD AArch64 CACHE STRING "Native backend" FORCE)
set(LLVM_ENABLE_ASSERTIONS ON CACHE BOOL "Diagnose experimental compiler failures" FORCE)
set(LLVM_BUILD_LLVM_DYLIB ON CACHE BOOL "Shared LLVM library" FORCE)
set(LLVM_LINK_LLVM_DYLIB ON CACHE BOOL "Share LLVM across tools" FORCE)
set(CLANG_LINK_CLANG_DYLIB ON CACHE BOOL "Share matching Clang libraries with IWYU" FORCE)
set(LLVM_INSTALL_TOOLCHAIN_ONLY OFF CACHE BOOL "Retain headers and CMake exports for IWYU" FORCE)
set(LLVM_PARALLEL_COMPILE_JOBS 4 CACHE STRING "Compile pool limit" FORCE)
set(LLVM_PARALLEL_LINK_JOBS 1 CACHE STRING "Link pool limit" FORCE)
set(LLVM_PARALLEL_TABLEGEN_JOBS 1 CACHE STRING "TableGen pool limit" FORCE)
foreach(_name LLVM_INCLUDE_TESTS LLVM_INCLUDE_BENCHMARKS LLVM_INCLUDE_EXAMPLES LLVM_INCLUDE_DOCS
    LIBCXX_INCLUDE_TESTS LIBCXXABI_INCLUDE_TESTS LIBUNWIND_INCLUDE_TESTS COMPILER_RT_INCLUDE_TESTS
    LLVM_ENABLE_LIBXML2 LLVM_ENABLE_LIBEDIT LLVM_ENABLE_LIBPFM LLVM_ENABLE_ZLIB LLVM_ENABLE_ZSTD
    LLVM_ENABLE_CURL COMPILER_RT_ENABLE_IOS COMPILER_RT_ENABLE_WATCHOS COMPILER_RT_ENABLE_TVOS
    COMPILER_RT_ENABLE_XROS COMPILER_RT_BUILD_XRAY COMPILER_RT_BUILD_LIBFUZZER
    COMPILER_RT_BUILD_MEMPROF COMPILER_RT_BUILD_CTX_PROFILE COMPILER_RT_BUILD_ORC)
  set(${_name} OFF CACHE BOOL "Outside this native foundation" FORCE)
endforeach()
foreach(_name LIBCXX_ENABLE_SHARED LIBCXX_ENABLE_STATIC LIBCXXABI_ENABLE_SHARED LIBCXXABI_ENABLE_STATIC
    LIBUNWIND_ENABLE_SHARED LIBUNWIND_ENABLE_STATIC LIBCXXABI_USE_LLVM_UNWINDER
    COMPILER_RT_BUILD_SANITIZERS COMPILER_RT_BUILD_PROFILE
    COMPILER_RT_DEFAULT_TARGET_ONLY)
  set(${_name} ON CACHE BOOL "Required runtime capability" FORCE)
endforeach()
set(DARWIN_osx_ARCHS arm64 CACHE STRING "Native sanitizer runtime" FORCE)
set(DARWIN_osx_BUILTIN_ARCHS arm64 CACHE STRING "Native compiler builtins" FORCE)
set(DARWIN_macosx_CACHED_SYSROOT "$ENV{MARKETPLACE_BOOTSTRAP_SDK}" CACHE STRING "Pinned compiler-rt SDK" FORCE)
# Upstream forwards runtime-prefixed options; these CMake values are explicit too.
set(_runtime_args "-DCMAKE_OSX_ARCHITECTURES=arm64;-DCMAKE_OSX_DEPLOYMENT_TARGET=27.0;-DCMAKE_OSX_SYSROOT=$ENV{MARKETPLACE_BOOTSTRAP_SDK};-DCMAKE_INSTALL_RPATH=@loader_path/../lib")
set(RUNTIMES_CMAKE_ARGS "${_runtime_args}" CACHE STRING "Runtime CMake inputs" FORCE)
set(BUILTINS_CMAKE_ARGS "${_runtime_args}" CACHE STRING "Builtin CMake inputs" FORCE)
