# Initial cache for the pinned IWYU tool; native execution needs separate admission.
if(NOT "$ENV{MARKETPLACE_CPP_LANE}" STREQUAL "tools-only")
  message(FATAL_ERROR "Select the isolated cpp-build environment for IWYU.")
endif()
foreach(_name CC CXX CFLAGS CXXFLAGS CPPFLAGS LDFLAGS CPATH CPLUS_INCLUDE_PATH
    C_INCLUDE_PATH LIBRARY_PATH SDKROOT DYLD_LIBRARY_PATH DYLD_FALLBACK_LIBRARY_PATH
    CMAKE_TOOLCHAIN_FILE CMAKE_C_COMPILER_LAUNCHER CMAKE_CXX_COMPILER_LAUNCHER)
  if(NOT "$ENV{${_name}}" STREQUAL "")
    message(FATAL_ERROR "Inherited ${_name} must be cleared before IWYU bootstrap.")
  endif()
endforeach()
foreach(_name CC CXX SDK NINJA LLVM_PREFIX PREFIX)
  set(_value "$ENV{MARKETPLACE_IWYU_${_name}}")
  if(NOT IS_ABSOLUTE "${_value}" OR _value STREQUAL "/")
    message(FATAL_ERROR "Provide an attested absolute MARKETPLACE_IWYU_${_name}.")
  endif()
  if(NOT _name STREQUAL "PREFIX" AND NOT EXISTS "${_value}")
    message(FATAL_ERROR "IWYU input does not exist: ${_name}")
  endif()
endforeach()
set(_llvm "$ENV{MARKETPLACE_IWYU_LLVM_PREFIX}")
set(_install "$ENV{MARKETPLACE_IWYU_PREFIX}")
cmake_path(NORMAL_PATH _llvm)
cmake_path(NORMAL_PATH _install)
cmake_path(IS_PREFIX _llvm "${_install}" NORMALIZE _inside_llvm)
if(_inside_llvm OR EXISTS "${_install}")
  message(FATAL_ERROR "IWYU needs a new separate private install prefix.")
endif()
foreach(_package llvm/LLVMConfig.cmake clang/ClangConfig.cmake)
  if(NOT EXISTS "${_llvm}/lib/cmake/${_package}")
    message(FATAL_ERROR "Missing qualified fork package: ${_package}")
  endif()
endforeach()
foreach(_name CMAKE_TOOLCHAIN_FILE CMAKE_INSTALL_RPATH CMAKE_BUILD_RPATH
    CMAKE_C_COMPILER_LAUNCHER CMAKE_CXX_COMPILER_LAUNCHER CLANG_RESOURCE_DIR IWYU_RESOURCE_DIR)
  if(NOT "${${_name}}" STREQUAL "")
    message(FATAL_ERROR "IWYU bootstrap requires an unset ${_name}.")
  endif()
endforeach()
set(CMAKE_C_COMPILER "$ENV{MARKETPLACE_IWYU_CC}" CACHE FILEPATH "Admitted Apple bootstrap C compiler" FORCE)
set(CMAKE_CXX_COMPILER "$ENV{MARKETPLACE_IWYU_CXX}" CACHE FILEPATH "Admitted Apple bootstrap C++ compiler" FORCE)
set(CMAKE_OSX_SYSROOT "$ENV{MARKETPLACE_IWYU_SDK}" CACHE PATH "Admitted SDK" FORCE)
set(CMAKE_MAKE_PROGRAM "$ENV{MARKETPLACE_IWYU_NINJA}" CACHE FILEPATH "Managed Ninja" FORCE)
set(CMAKE_INSTALL_PREFIX "${_install}" CACHE PATH "New separate IWYU prefix" FORCE)
set(CMAKE_BUILD_TYPE Release CACHE STRING "Tool build configuration" FORCE)
set(CMAKE_OSX_ARCHITECTURES arm64 CACHE STRING "Native architecture" FORCE)
set(CMAKE_OSX_DEPLOYMENT_TARGET 27.0 CACHE STRING "Qualified host platform" FORCE)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON CACHE BOOL "Retain native compiler commands" FORCE)
set(LLVM_DIR "${_llvm}/lib/cmake/llvm" CACHE PATH "Qualified LLVM package" FORCE)
set(Clang_DIR "${_llvm}/lib/cmake/clang" CACHE PATH "Exact matching Clang package" FORCE)
set(LLVM_ENABLE_LIBCXX OFF CACHE BOOL "Preserve admitted Apple default stdlib" FORCE)
set(LLVM_STATIC_LINK_CXX_STDLIB OFF CACHE BOOL "Preserve admitted dynamic stdlib" FORCE)
set(IWYU_LINK_CLANG_DYLIB ON CACHE BOOL "Use exact fork Clang dylib" FORCE)
set(IWYU_RESOURCE_RELATIVE_TO clang CACHE STRING "Fixed qualified Clang resource anchor" FORCE)
set(LLVM_PARALLEL_COMPILE_JOBS 1 CACHE STRING "Bound native compile pool" FORCE)
set(LLVM_PARALLEL_LINK_JOBS 1 CACHE STRING "Bound native link pool" FORCE)
set(CMAKE_DISABLE_FIND_PACKAGE_Python3 TRUE CACHE BOOL "Do not enumerate upstream Python tests at configure" FORCE)
# AddLLVM supplies the separate-prefix Darwin rpaths; do not replace that logic.
# IWYU sets C++17 and inherits fork assertions, RTTI, EH and LLVM link policy.
